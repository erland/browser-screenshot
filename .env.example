PORT=8080
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:8080
CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium

# Local/dev may use DATABASE_URL directly.
DATABASE_URL=postgresql://browser_screenshot:change-me@postgres:5432/browser_screenshot

# Coolify/production may instead omit DATABASE_URL and provide:
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=browser_screenshot
# DB_USER=browser_screenshot
# DB_PASSWORD=replace-me

GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me
SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional, comma-separated. When set, this becomes the authoritative enabled
# GitHub e-mail allowlist at startup. Missing/empty leaves the DB allowlist untouched.
BROWSER_SCREENSHOT_GITHUB_ALLOWLIST_EMAILS=

# Separate signing secret for MCP bearer access tokens (32+ chars)
MCP_TOKEN_SECRET=replace-with-at-least-32-random-characters
